APP_ENV=development
APP_NAME=project-g
APP_VERSION=0.1.0
APP_SECRET_KEY=
LOG_LEVEL=INFO
TIMEZONE=Asia/Tokyo

API_HOST=0.0.0.0
API_PORT=8000

DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=project_g
DATABASE_USER=project_g
DATABASE_PASSWORD=

REDIS_HOST=queue
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=5
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
REDIS_MAX_CONNECTIONS=20

RQ_DEFAULT_QUEUE=default
RQ_SYSTEM_QUEUE=system
RQ_JOB_TIMEOUT_SECONDS=300
RQ_MAX_RETRIES=3
RQ_RESULT_TTL_SECONDS=3600
RQ_FAILURE_TTL_SECONDS=604800

SCHEDULER_INTERVAL_SECONDS=60
SCHEDULER_LOCK_TIMEOUT_SECONDS=30
SCHEDULER_LOCK_KEY=project-g:scheduler:lock

COLLECTION_REQUEST_TIMEOUT_SECONDS=10
COLLECTION_MAX_RESPONSE_BYTES=2000000
COLLECTION_MAX_REDIRECTS=3
COLLECTION_USER_AGENT=ProjectG/0.1 (metadata-only news collector)

PUBLISHING_ENABLED=false

OPENAI_API_KEY=
OPENAI_RELEVANCE_MODEL=gpt-5.6-luna
OPENAI_PRIORITY_MODEL=gpt-5.6-luna
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
OPENAI_TTS_FORMAT=mp3
OPENAI_TTS_INSTRUCTIONS=Speak in natural Japanese with clear pacing suitable for a short-form sports news narration.
MEDIA_STORAGE_ROOT=/app/media
OPENAI_REQUEST_TIMEOUT_SECONDS=30
